POSTGRES_URL=postgresql+psycopg://postgres:your_password@localhost:5432/postgres
DB_SCHEMA=ecommerce
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
ALLOWED_TABLES=customers,orders,order_items,products,returns,refunds,inventory,shipments
APPROVAL_REQUIRED_ACTIONS=refund_order,create_return,cancel_order,update_inventory
LOG_DIR=logs
USE_POSTGRES_FOR_APPROVALS=true
USE_POSTGRES_FOR_USERS=true
APP_ENV=dev
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGGRAPH_CHECKPOINT_STORE=postgresql
# Use "memory" only for local development or stateless test processes.
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
APP_VERSION=0.1.0
LLM_TIMEOUT_SECONDS=60
API_REQUEST_TIMEOUT_SECONDS=180
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=480